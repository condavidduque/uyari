FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY workers/ingest/package.json workers/ingest/
COPY workers/extract/package.json workers/extract/
COPY workers/live-guide/package.json workers/live-guide/
COPY packages/schemas/package.json packages/schemas/
RUN npm ci --workspaces --include-workspace-root
COPY apps/api apps/api
RUN npm run build --workspace @uyari/api

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY workers/ingest/package.json workers/ingest/
COPY workers/extract/package.json workers/extract/
COPY workers/live-guide/package.json workers/live-guide/
COPY packages/schemas/package.json packages/schemas/
RUN npm ci --omit=dev --workspace @uyari/api --include-workspace-root \
 && npm cache clean --force
COPY --from=build /app/apps/api/dist apps/api/dist
USER node
EXPOSE 5900
CMD ["node", "apps/api/dist/index.js"]
