{
  "name": "uyari",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "uyari",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "workers/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@uyari/api",
      "version": "0.1.0",
      "dependencies": {
        "jose": "^6.2.12"
      }
    },
    "apps/web": {
      "name": "@uyari/web",
      "version": "0.1.0"
    },
    "node_modules/@uyari/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@uyari/schemas": {
      "resolved": "packages/schemas",
      "link": true
    },
    "node_modules/@uyari/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@uyari/worker-extract": {
      "resolved": "workers/extract",
      "link": true
    },
    "node_modules/@uyari/worker-ingest": {
      "resolved": "workers/ingest",
      "link": true
    },
    "node_modules/@uyari/worker-live-guide": {
      "resolved": "workers/live-guide",
      "link": true
    },
    "node_modules/jose": {
      "version": "6.2.12",
      "resolved": "https://registry.npmjs.org/jose/-/jose-6.2.12.tgz",
      "integrity": "sha512-9NiFmJEex0sy2Dk58j2UGBSHgUs2ypF9eZSu4L6vjOX3Dp96Sw1F3uL+H+D1sx02jZZdzUT0HgvCy59CuvXcWw==",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/panva"
      }
    },
    "packages/schemas": {
      "name": "@uyari/schemas",
      "version": "0.1.0"
    },
    "workers/extract": {
      "name": "@uyari/worker-extract",
      "version": "0.1.0"
    },
    "workers/ingest": {
      "name": "@uyari/worker-ingest",
      "version": "0.1.0"
    },
    "workers/live-guide": {
      "name": "@uyari/worker-live-guide",
      "version": "0.1.0"
    }
  }
}
